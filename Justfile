check *args=".":
    #!/usr/bin/env fish

    set -l nvim_bin (command -v nvim)

    # Resolve symlinks to get the actual Nix store path
    set -l nvim_real (realpath $nvim_bin)

    # Extract the Nix store package root (e.g. /nix/store/<hash>-neovim-x.y.z)
    set -l nvim_store_root (string match -r '^/nix/store/[^/]+' $nvim_real)

    if test -z "$nvim_store_root"
        echo "Error: nvim is not installed via Nix ($nvim_real)" >&2
        exit 1
    end

    # Look for the runtime directory in the package
    set -l runtime_dir "$nvim_store_root/share/nvim/runtime"

    if test -z "$runtime_dir"; or not test -d "$runtime_dir"
        echo "Error: could not locate VIMRUNTIME in $nvim_store_root" >&2
        exit 1
    end

    # plenary.nvim/lua/plenary/busted.lua globally redefines `assert` as
    # Luassert, which is not fixed by our own workspace/library ignore config:
    # emmylua_check's --config flag canonicalizes the (Nix-store-symlinked)
    # config file and takes its *parent* as the config root, so relative
    # excludes resolve against /nix/store instead of this project. Passing
    # --ignore here avoids that path entirely.
    VIMRUNTIME=$runtime_dir emmylua_check --ignore "**/plenary/busted.lua" {{ args }}

format:
    @stylua **/*.lua

# Rebuild queries/lini/highlights.scm from lini's Zed query; src is a URL or a local file.
lini-queries src="https://raw.githubusercontent.com/monfa-red/lini/main/editors/zed/languages/lini/highlights.scm":
    #!/usr/bin/env -S uv run --script --quiet
    # /// script
    # requires-python = ">=3.14"
    # ///
    import re
    import sys
    import urllib.request
    from pathlib import Path

    SOURCE = "{{ src }}"
    TARGET = Path("queries/lini/highlights.scm")
    CAPTURES = {"@variable.other.member": "@variable.member"}
    STRING = re.compile(r'"(?:\\.|[^"\\])*"')
    MATCH = re.compile(r'\(#match\? (@[\w.]+) "\^\(([^"]*)\)\$"\)')
    PLAIN = re.compile(r"\((\w+)\) @")
    KEYED = re.compile(r"\(\((\w+)\) @")


    def read_source() -> str:
        if SOURCE.startswith("https://"):
            return urllib.request.urlopen(SOURCE).read().decode()
        return Path(SOURCE).expanduser().read_text()


    def split_patterns(text: str) -> list[str]:
        patterns: list[str] = []
        lines: list[str] = []
        depth = 0
        for line in text.splitlines():
            code = re.sub(r";.*", "", STRING.sub('""', line))
            if not lines and not code.strip():
                continue
            lines.append(line)
            depth += code.count("(") + code.count("[") - code.count(")") - code.count("]")
            if depth == 0:
                patterns.append("\n".join(lines))
                lines = []
        return patterns


    def any_of(match: re.Match[str]) -> str:
        if not re.fullmatch(r"[\w-]+(\|[\w-]+)*", match[2]):
            sys.exit(f"lini-queries: no #any-of? form for {match[0]}")
        return f"(#any-of? {match[1]} " + " ".join(f'"{word}"' for word in match[2].split("|")) + ")"


    def convert(pattern: str) -> str:
        pattern = MATCH.sub(any_of, pattern)
        if "#match?" in pattern:
            sys.exit(f"lini-queries: unconverted #match? in {pattern}")
        return re.sub(r"@[\w.]+", lambda capture: CAPTURES.get(capture[0], capture[0]), pattern)


    # Zed applies the first pattern that matches a node; Neovim applies the last one.
    def reorder(patterns: list[str]) -> list[str]:
        ordered: list[str] = []
        for pattern in patterns:
            at = len(ordered)
            if plain := PLAIN.match(pattern):
                while at and (keyed := KEYED.match(ordered[at - 1])) and keyed[1] == plain[1]:
                    at -= 1
            ordered.insert(at, pattern)
        return ordered


    patterns = reorder([convert(pattern) for pattern in split_patterns(read_source())])
    TARGET.write_text("; Generated by `just lini-queries` from lini's Zed highlights.scm; do not edit.\n" + "\n".join(patterns) + "\n")
    print(f"{TARGET}: {len(patterns)} patterns")
